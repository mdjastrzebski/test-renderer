{
  "name": "test-renderer",
  "version": "1.3.0",
  "description": "A lightweight test renderer for React and a modern replacement for the deprecated React Test Renderer.",
  "keywords": [
    "jest",
    "react",
    "react-19",
    "react-test-renderer",
    "test-renderer",
    "testing"
  ],
  "homepage": "https://github.com/mdjastrzebski/test-renderer",
  "license": "MIT",
  "author": "Maciej Jastrzebski <mdjastrzebski@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/mdjastrzebski/test-renderer.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check:dist": "node scripts/check-dist.mjs",
    "check:react-release-guard": "node scripts/check-react-release-guard.mjs",
    "dev": "tsdown --watch",
    "test": "jest",
    "test:ci": "jest --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:watch": "jest --watch",
    "validate": "bun run typecheck && bun run test && bun run lint && bun run format:check",
    "validate:fix": "bun run format && bun run lint --fix && bun run typecheck && bun run test -u",
    "format": "oxfmt --disable-nested-config .",
    "format:check": "oxfmt --disable-nested-config --check .",
    "release": "release-it"
  },
  "dependencies": {
    "@types/react-reconciler": "~0.34.0",
    "react-reconciler": "~0.34.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jest": "^30.5.2",
    "oxfmt": "^0.72.0",
    "react": "^19.3.0",
    "release-it": "^21.1.1",
    "ts-jest": "^29.4.14",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "testRenderer": {
    "supportedReactRange": ">=19.0.0 <19.4.0"
  }
}
