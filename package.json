{
  "name": "test-renderer",
  "version": "0.15.0",
  "description": "A lightweight, JavaScript-only replacement for the deprecated React Test Renderer.",
  "keywords": [
    "react",
    "react-test-renderer",
    "testing",
    "test-renderer",
    "react-19",
    "jest"
  ],
  "author": "Maciej Jastrzebski <mdjastrzebski@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mdjastrzebski/test-renderer.git"
  },
  "homepage": "https://github.com/mdjastrzebski/test-renderer",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check:react-release-guard": "node scripts/check-react-release-guard.mjs",
    "dev": "tsup --watch",
    "test": "jest",
    "test:ci": "jest --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:watch": "jest --watch",
    "validate": "bun run typecheck && bun run test && bun run lint && bun run format:check",
    "validate:fix": "bun run format:fix && bun run lint --fix && bun run typecheck && bun run test -u",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "release": "release-it"
  },
  "testRenderer": {
    "supportedReactRange": ">=19.0.0 <19.3.0"
  },
  "dependencies": {
    "react-reconciler": "~0.31.0",
    "@types/react-reconciler": "~0.31.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.3.0",
    "@release-it/conventional-changelog": "^10.0.6",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.14",
    "eslint": "^10.2.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "jest": "^30.3.0",
    "prettier": "^3.8.2",
    "react": "^19.0.0",
    "release-it": "^19.2.4",
    "ts-jest": "^29.4.9",
    "tsup": "^8.5.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.1"
  }
}
